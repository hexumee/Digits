<ContentDialog
    x:Class="Digits.Pages.BackupPasswordDialog"
    x:Uid="BackupPasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel MaxWidth="420">
        <TextBlock x:Name="IntroText" TextWrapping="Wrap" Margin="0,0,0,12" />
        <PasswordBox x:Name="PassphraseBox" x:Uid="BackupPasswordField" />
        <StackPanel x:Name="ConfirmationPanel" Visibility="Collapsed">
            <PasswordBox x:Name="ConfirmationBox" x:Uid="BackupConfirmationField" Margin="0,8,0,0" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
