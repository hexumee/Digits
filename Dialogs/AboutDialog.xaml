<ContentDialog
    x:Class="Digits.Pages.AboutDialog"
    x:Uid="AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel MaxWidth="420">
        <TextBlock x:Uid="AboutProductName" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock x:Uid="AboutTagline" FontSize="16" Opacity="0.8" TextWrapping="Wrap" Margin="0,0,0,16" />
        <TextBlock x:Name="VersionText" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBlock x:Uid="AboutDescription" TextWrapping="Wrap" />
        <HyperlinkButton x:Uid="Icons8Attribution" NavigateUri="https://icons8.com/" HorizontalAlignment="Left" Margin="0,12,0,0" />
    </StackPanel>
</ContentDialog>
