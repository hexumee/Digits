<Application
    x:Class="Digits.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Digits">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="RowBackgroundBrush" Color="#e0e0e0"></SolidColorBrush>
                    <SolidColorBrush x:Key="RowLogoBackgroundBrush" Color="#c0c0c0"></SolidColorBrush>
                    <SolidColorBrush x:Key="RowSubtitleBrush" Color="DimGray"></SolidColorBrush>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="RowBackgroundBrush" Color="#1f1f1f"></SolidColorBrush>
                    <SolidColorBrush x:Key="RowLogoBackgroundBrush" Color="#3f3f3f"></SolidColorBrush>
                    <SolidColorBrush x:Key="RowSubtitleBrush" Color="LightGray"></SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
