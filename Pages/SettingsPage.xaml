<Page
    x:Class="Digits.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid HorizontalAlignment="Stretch" Margin="16 8 16 8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Uid="SettingsPageHeading" Grid.Row="0" FontSize="16" Margin="0 0 0 16" FontWeight="Bold"/>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="560" HorizontalAlignment="Stretch" Margin="0 0 0 24">
                <TextBlock x:Uid="SecurityHeading" FontSize="14" Margin="0,0,0,8" FontWeight="Bold"/>
                <TextBlock x:Uid="AppLockHelp" TextWrapping="Wrap" Opacity="0.75" Margin="0 0 0 8"/>
                <TextBlock x:Uid="AppLockToggleLabel" TextWrapping="Wrap" />
                <ToggleSwitch x:Name="AppLockToggle" x:Uid="AppLockToggle" HorizontalAlignment="Left" />

                <TextBlock x:Uid="BackupHeading" FontSize="14" Margin="0,16,0,8" FontWeight="Bold"/>
                <TextBlock x:Uid="BackupDescription" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,12" />
                <Button x:Uid="ImportBackupAction" Click="ImportBackup_Click" HorizontalAlignment="Stretch" Margin="0,0,0,12"/>
                <Button x:Uid="ExportBackupAction" Click="ExportBackup_Click" HorizontalAlignment="Stretch" Margin="0,0,0,12"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
