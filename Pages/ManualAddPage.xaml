<Page
    x:Class="Digits.ManualAddPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton x:Uid="AddTokenButton" x:Name="SaveButton" Icon="Add" Click="Save_Click" />
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Uid="CancelButton" Icon="Cancel" Click="Cancel_Click" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>

    <Grid HorizontalAlignment="Stretch" Margin="16 8 16 8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Uid="ManualPageHeading" Grid.Row="0" FontSize="16" Margin="0 0 0 16" FontWeight="Bold"/>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="560" HorizontalAlignment="Stretch" Margin="0 0 0 24">
                <TextBlock x:Name="Description" TextWrapping="Wrap" Opacity="0.75" Margin="0 0 0 24" />

                <StackPanel>
                    <ComboBox x:Name="TypeBox" Margin="0 0 0 12" />
                    <TextBox x:Name="IssuerBox" Margin="0 0 0 12" />
                    <TextBox x:Name="AccountBox" Margin="0 0 0 12" />
                    <PasswordBox x:Name="SecretBox" Margin="0 0 0 12" />
                    <ComboBox x:Name="AlgorithmBox" Margin="0 0 0 12" />
                    <ComboBox x:Name="DigitsBox" Margin="0 0 0 12" />
                    <TextBox x:Name="PeriodBox" x:Uid="ManualPeriodBox" Margin="0 0 0 12" />
                    <TextBox x:Name="CounterBox" x:Uid="ManualCounterBox" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
